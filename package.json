{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nx serve web",
    "start:api": "cd api && php artisan serve --host=127.0.0.1 --port=8000",
    "start:all": "concurrently --kill-others-on-fail --names web,api \"npm run start\" \"npm run start:api\"",
    "start:full": "npm run db:migrate && npm run start:all",
    "build": "nx build web",
    "build:all": "npm run build",
    "watch": "nx build web --watch --configuration development",
    "test": "npm run test:web && npm run test:api",
    "test:web": "nx test web",
    "test:api": "cd api && php artisan test",
    "db:migrate": "cd api && php artisan migrate",
    "db:seed": "cd api && php artisan db:seed",
    "db:fresh": "cd api && php artisan migrate:fresh --seed"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.23",
    "@angular/compiler": "^21.2.23",
    "@angular/core": "^21.2.23",
    "@angular/forms": "^21.2.23",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.23",
    "@angular/router": "^21.2.23",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.2.24",
    "@angular-devkit/schematics": "^21.2.24",
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.23",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "22.7.12",
    "@nx/eslint": "22.7.12",
    "@nx/eslint-plugin": "22.7.12",
    "@nx/jest": "22.7.12",
    "@nx/js": "22.7.12",
    "@nx/web": "22.7.12",
    "@nx/workspace": "22.7.12",
    "@schematics/angular": "^21.2.24",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.43",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "concurrently": "^10.0.5",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.7.12",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.11"
  }
}
